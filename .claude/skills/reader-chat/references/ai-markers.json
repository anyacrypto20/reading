{
  "about": "Біблія ШІ маркерів для чату рідера. Регулярки без урахування регістру. level error це заборона, warn це місце яке треба перечитати.",
  "patterns": [
    {"id": "dash", "level": "error", "pattern": "[—–]|(?<=\\s)-(?=\\s)", "note": "тире"},
    {"id": "bullet", "level": "error", "pattern": "^\\s*(?:[*•▪◦]|-(?=\\s)|\\d+[.)](?=\\s))", "note": "маркер списку або нумерація"},
    {"id": "ne_a", "level": "warn", "pattern": "(?<!\\w)не\\s(?:[^.!?\\n]{1,60}?)[,\\s]\\s*а\\s", "note": "конструкція не X а Y"},
    {"id": "ne_tse", "level": "warn", "pattern": "(?<!\\w)не\\s[^.!?\\n]{1,60}[.!?]\\s*(?:це|это|а)\\s", "note": "конструкція не X. це Y"},
    {"id": "ne_prosto", "level": "error", "pattern": "(?<!\\w)не\\s+(?:просто|лише|тільки|только)(?!\\w)[^.!?\\n]{0,60}?[,\\s]\\s*(?:а|но|але)\\s", "note": "не просто X а Y"},
    {"id": "tse_ne_pro", "level": "error", "pattern": "(?<!\\w)(?:це|это)\\s+не\\s+про(?!\\w)", "note": "це не про X"},
    {"id": "bez_bez", "level": "error", "pattern": "(?<!\\w)без\\s+\\w+[,\\s]+без(?!\\w)", "note": "пара без X без Y"},
    {"id": "rhetorical", "level": "warn", "pattern": "\\?[ \\t]+\\w", "note": "питання і одразу відповідь в тому ж повідомленні"},
    {"id": "ellipsis", "level": "warn", "pattern": "\\.\\.\\.|…", "note": "три крапки як інтрига"},
    {"id": "en_not_just", "level": "error", "pattern": "(?<!\\w)not\\s+(?:just|only|simply)\\b[^.!?\\n]{0,60}?\\bbut\\b", "note": "not just X but Y"},
    {"id": "en_not_about", "level": "error", "pattern": "\\b(?:it'?s|this is|that'?s|it is)\\s+not\\s+about\\b", "note": "it's not about X"},
    {"id": "en_isnt_its", "level": "warn", "pattern": "\\bisn'?t\\b[^.!?\\n]{1,60}?[,.]\\s*(?:it'?s|he'?s|she'?s)\\b", "note": "isn't X, it's Y"}
  ],
